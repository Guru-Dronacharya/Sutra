# Sutra Environment Configuration
# Default to SQLite for zero-setup local dev/tests, or use PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///sutra.db
SYNC_DATABASE_URL=sqlite:///sutra.db
# For Docker Compose / Production:
# DATABASE_URL=postgresql+asyncpg://sutra:sutra123@localhost:5432/sutra_db
# SYNC_DATABASE_URL=postgresql://sutra:sutra123@localhost:5432/sutra_db

# Security & JWT
JWT_SECRET_KEY=sutra_super_secret_jwt_key_india_governance_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service Ports
API_PORT=8000
GATEWAY_PORT=8001
AUDIT_PORT=8002
RAG_PORT=8003
ML_PORT=8004

# Service Inter-communication
API_URL=http://localhost:8000
GATEWAY_URL=http://localhost:8001
AUDIT_URL=http://localhost:8002
RAG_URL=http://localhost:8003
ML_URL=http://localhost:8004
AUDIT_SERVICE_TOKEN=sutra_audit_internal_service_token_xyz
AUDIT_STORE_REDACTED_TEXT=false

# Vector Store (chroma or qdrant)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Object Storage (MinIO or local filesystem)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sutra-corpus
LOCAL_STORAGE_DIR=./data/storage

# ML Injection Backend (transformer or fallback)
INJECTION_BACKEND=fallback

# LLM Provider (mock or openai_compatible)
UPSTREAM_PROVIDER=mock
UPSTREAM_BASE_URL=http://localhost:8000/v1/mock
UPSTREAM_API_KEY=mock-key
# Real provider optional:
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=sk-...
